# Backend Environment Variables Example
# Copy this file or set these environment variables in your deployment platform (e.g. Render)

# Port (Render/Cloud sets this automatically)
PORT=8080

# Database Configuration (For Local or Aiven Cloud MySQL)
# Local MySQL example:
# DB_URL=jdbc:mysql://localhost:3306/ems_database?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_local_password

# Aiven Cloud MySQL example:
# DB_URL=jdbc:mysql://mysql-yourproject-aivencloud.com:12345/defaultdb?sslMode=REQUIRED
# DB_USERNAME=avnadmin
# DB_PASSWORD=your_aiven_password
